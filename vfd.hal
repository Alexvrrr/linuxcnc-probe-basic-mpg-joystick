#Все что ниже - естоп если частотник упал в ошибку
# 1. Загружаем нужные компоненты
# Если loadrt and2 или loadrt not уже есть — увеличьте их count
loadrt comp count=1
loadrt and2 count=1
# loadrt not count=2  # предполагаем, что not.0 уже занят, используем not.1

# 2. Добавляем в поток
addf comp.0 servo-thread
addf and2.0 servo-thread
addf not.1 servo-thread


# 3. Логика сравнения кода ошибки частотника
setp comp.0.in0 0.1  # сравниваю не с 0 потому что при сравнении с 0 компаратор зависает из за равенства значений, а ему нужен порог переключения
net vfd-error-code vfdmod.parameters.ErrorSpindle => comp.0.in1

# 4. Превращаем "есть ошибка" в "VFD исправен" (инвертируем)
net vfd-is-bad comp.0.out => not.1.in
net vfd-is-ok not.1.out => and2.0.in0

# 5. Перехватываем старый сигнал estop-ext и заводим его во второй вход "И"
# Сначала нужно найти в файле строку "net estop-ext iocontrol.0.emc-enable-in"
# и УДАЛИТЬ ИЛИ ЗАКОММЕНТИРОВАТЬ ЕЁ.
# Вместо неё пишем:
net estop-ext => and2.0.in1

# 6. Общий выход "И" теперь управляет остановкой станка
net total-estop-ok and2.0.out => iocontrol.0.emc-enable-in


#сообщение об ошибке частотника

loadrt message names=errorvfd messages="VFD ERROR"
addf errorvfd servo-thread
setp errorvfd.edge 1

net vfd-is-bad => errorvfd.trigger



